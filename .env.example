# Cookie signing secret, 64+ bytes. Generate one with:
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SESSION_SECRET=replace-me
# SQLite event store + read models, relative to the app directory
DATABASE_PATH=storage/coffeeshop.db
# Web server (falcon.rb)
HOST=localhost
PORT=9292
# Falcon worker processes (Sourced runtime runs on the elected leader only)
COUNT=2
